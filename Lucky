local ESPHighlights={},ConfigFileName="LuckyConfig.json"
local function clamp(v,a,b) return math.max(a,math.min(b,v)) end
local function ReadSavedConfig()
    if type(readfile)~="function" or type(isfile)~="function" then return end
    local ok,data=pcall(function()
        if not isfile(ConfigFileName) then return nil end
        return HttpService:JSONDecode(readfile(ConfigFileName))
    end)
    if ok and type(data)=="table" then
        if type(data.FOV)=="number" then FOV=clamp(data.FOV,20,300) end
        if type(data.TrackingStrength)=="number" then TrackingStrength=clamp(data.TrackingStrength,0.01,0.50) end
        if type(data.TeamCheck)=="boolean" then TeamCheck=data.TeamCheck end
        if type(data.AimEnabled)=="boolean" then AimEnabled=data.AimEnabled end
        if type(data.ESPEnabled)=="boolean" then ESPEnabled=data.ESPEnabled end
        if type(data.FOVCircleEnabled)=="boolean" then FOVCircleEnabled=data.FOVCircleEnabled end
    end
end
ReadSavedConfig()
local TEAM_MARKERS={"StageTeamSide","Team","TeamName","TeamColor","TeamId","TeamID","team"}
local function readTeamMarker(inst)
    if not inst then return nil end
    for _,n in ipairs(TEAM_MARKERS) do
        local a=inst:GetAttribute(n)
        if a~=nil then return n.."="..tostring(a) end
        local c=inst:FindFirstChild(n)
        if c and c:IsA("ValueBase") then return n.."="..tostring(c.Value) end
    end
    return nil
end
local function getCustomTeamIdentity(p)
    if not p then return nil end
    local m=readTeamMarker(p) or readTeamMarker(p.Character)
    if m then return m end
    local stats=p:FindFirstChild("leaderstats")
    if stats then m=readTeamMarker(stats) if m then return m end end
    if p.TeamColor~=nil then return "TeamColor="..tostring(p.TeamColor) end
    return nil
end
local customTeamCache={count=0,at=0}
local function getCustomTeamCount()
    local now=os.clock()
    if now-customTeamCache.at>0.5 then
        local seen={},c=0
        for _,pl in ipairs(Players:GetPlayers()) do
            local id=getCustomTeamIdentity(pl)
            if id and not seen[id] then seen[id]=true; c=c+1 end
        end
        customTeamCache.count=c; customTeamCache.at=now
    end
    return customTeamCache.count
end
local function isTeammate(target)
    if not target or target==LocalPlayer then return false end
    if LocalPlayer.Team and target.Team then return LocalPlayer.Team==target.Team end
    local lt=getCustomTeamIdentity(LocalPlayer); local tt=getCustomTeamIdentity(target)
    if not lt or not tt then return false end
    return getCustomTeamCount()>=2 and lt==tt
end

