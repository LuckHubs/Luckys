-- ESP
local function RemoveESP(Player) local H=ESPHighlights[Player] if H then H:Destroy(); ESPHighlights[Player]=nil end end
local function CreateESP(Player)
    if Player==LocalPlayer then return end
    local Char=Player.Character if not Char then RemoveESP(Player); return end
    local Hum=Char:FindFirstChildOfClass("Humanoid") if not Hum or Hum.Health<=0 then RemoveESP(Player); return end
    local H=ESPHighlights[Player] if not H or H.Parent~=Char then RemoveESP(Player); H=Instance.new("Highlight"); H.Name="LuckyTeamESP"; H.Adornee=Char; H.DepthMode=Enum.HighlightDepthMode.AlwaysOnTop; H.FillTransparency=1; H.OutlineTransparency=0.4; H.Parent=Char; ESPHighlights[Player]=H end
    local IsT=isTeammate(Player); H.OutlineColor= IsT and Color3.fromRGB(0,145,255) or Color3.fromRGB(255,55,55)
end
function RefreshESP()
    if not ESPEnabled then for p in pairs(ESPHighlights) do RemoveESP(p) end return end
    for _,p in ipairs(Players:GetPlayers()) do if p~=LocalPlayer then CreateESP(p) end end
end
Players.PlayerRemoving:Connect(RemoveESP)
Players.PlayerAdded:Connect(function(p) p.CharacterAdded:Connect(function() task.wait(0.2) if ESPEnabled then CreateESP(p) end end) end)

-- Targeting
local function GetTarget()
    local Camera=Workspace.CurrentCamera if not Camera then return nil end
    local V=Camera.ViewportSize if not V or V.X<=0 or V.Y<=0 then return nil end
    local Center=Vector2.new(V.X/2,V.Y/2); local ClosestHead=nil; local ClosestDist=FOV
    for _,pl in ipairs(Players:GetPlayers()) do
        local IsT=isTeammate(pl)
        if pl~=LocalPlayer and not (TeamCheck and IsT) then
            local Char=pl.Character
            if Char then
                local Hum=Char:FindFirstChildOfClass("Humanoid"); local Head=Char:FindFirstChild("Head")
                if Hum and Hum.Health>0 and Head then
                    local Pos,on=Camera:WorldToViewportPoint(Head.Position)
                    if on and Pos.Z>0 then
                        local P=Vector2.new(Pos.X,Pos.Y); local Dist=(P-Center).Magnitude
                        if Dist<=ClosestDist then
                            local Origin=Camera.CFrame.Position; local Dir=Head.Position-Origin
                            local Params=RaycastParams.new(); Params.FilterType=Enum.RaycastFilterType.Exclude
                            local Filter={}
                            local LC=LocalPlayer.Character if LC then table.insert(Filter,LC) end
                            Params.FilterDescendantsInstances=Filter; Params.IgnoreWater=true
                            local Result=Workspace:Raycast(Origin,Dir,Params); local Visible=true
                            if WallCheck then if Result~=nil and Result.Instance~=nil and not Result.Instance:IsDescendantOf(Char) then Visible=false end end
                            if Visible then ClosestDist=Dist; ClosestHead=Head end
                        end
                    end
                end
            end
        end
    end
    return ClosestHead
end

-- Aim loop
local LastESPRefresh=0
RunService.RenderStepped:Connect(function()
    local Now=os.clock()
    if Now-LastESPRefresh>=0.20 then RefreshESP(); LastESPRefresh=Now end
    FOVCircle.Visible=FOVCircleEnabled
    local Camera=Workspace.CurrentCamera if not Camera or not AimEnabled then return end
    local Target=GetTarget() if not Target then return end
    local Desired=CFrame.lookAt(Camera.CFrame.Position,Target.Position)
    Camera.CFrame=Camera.CFrame:Lerp(Desired,clamp(TrackingStrength,0,1))
end)
