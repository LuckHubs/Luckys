-- sliders helper (kept functional but concise)
local function MakeSlider(Name,LabelText,Y,Min,Max,Init,Format,OnChanged)
    local Track=Instance.new("TextButton"); Track.Name=Name.."Slider"; Track.Position=UDim2.fromOffset(10,Y+19); Track.Size=UDim2.new(1,-20,0,12); Track.Parent=Menu
    local Fill=Instance.new("Frame"); Fill.Name="Fill"; Fill.Size=UDim2.new((Init-Min)/(Max-Min),0,1,0); Fill.Parent=Track
    local Knob=Instance.new("Frame"); Knob.AnchorPoint=Vector2.new(0.5,0.5); Knob.Position=UDim2.new((Init-Min)/(Max-Min),0,0.5,0); Knob.Size=UDim2.fromOffset(14,14); Knob.Parent=Track
    local Value=Init; local Sliding=false; local ActiveInput=nil
    local function SetFromX(X)
        local Width=math.max(1,Track.AbsoluteSize.X); local Alpha=clamp((X-Track.AbsolutePosition.X)/Width,0,1)
        Value=Min+(Max-Min)*Alpha
        if Max>10 then Value=math.floor(Value+0.5) else Value=math.floor(Value*100+0.5)/100 end
        local Percent=(Value-Min)/(Max-Min)
        Fill.Size=UDim2.new(Percent,0,1,0); Knob.Position=UDim2.new(Percent,0,0.5,0)
        if type(OnChanged)=="function" then OnChanged(Value) end
    end
    Track.InputBegan:Connect(function(i) if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then Sliding=true; ActiveInput=i; SetFromX(i.Position.X) end end)
    UserInputService.InputChanged:Connect(function(i) if not Sliding then return end; if i==ActiveInput or (ActiveInput and ActiveInput.UserInputType==Enum.UserInputType.MouseButton1 and i.UserInputType==Enum.UserInputType.MouseMovement) then SetFromX(i.Position.X) end end)
    UserInputService.InputEnded:Connect(function(i) if i==ActiveInput or i.UserInputType==Enum.UserInputType.MouseButton1 then Sliding=false; ActiveInput=nil end end)
end
MakeSlider("FOV","FOV",148,20,300,FOV,function(v) return tostring(v).." px" end,function(v) FOV=v; FOVCircle.Size=UDim2.fromOffset(FOV*2,FOV*2) end)
